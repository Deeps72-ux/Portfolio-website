# Groq Configuration (Free & fast inference at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# OpenAI Configuration (Optional fallback)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Gmail SMTP Configuration for Contact Concierge Agent
# To enable real-time delivery to your Gmail, generate a 16-letter App Password at:
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=[EMAIL_ADDRESS]
SMTP_PASSWORD=your_16_letter_gmail_app_password
NOTIFICATION_EMAIL=[EMAIL_ADDRESS]
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
